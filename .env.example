# LLM provider keys (required before any live LLM call)
OPENAI_API_KEY=
OPENAI_BASE_URL=
DEEPSEEK_API_KEY=

# Embedding provider (decoupled from chat LLM).
# Default targets Aliyun DashScope's OpenAI-compatible endpoint with
# text-embedding-v4 projected to dim=1536 to match the existing Chroma collection.
# Get a DashScope key: https://help.aliyun.com/zh/model-studio/get-api-key
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1536

# Storage
DATABASE_URL=sqlite+aiosqlite:///./data/dnd.db
CHROMA_PATH=./data/chroma
CHROMA_COLLECTION=dnd_rag
SRD_DATA_PATH=./vendor/5e-database/src/2014/en
UPLOAD_DIR=./data/uploads
PARSED_DIR=./data/parsed

# Runtime
APP_ENV=dev
LOG_LEVEL=INFO
EMBEDDING_BATCH_SIZE=64
RETRIEVAL_TOP_K=8
MAX_UPLOAD_BYTES=20971520
